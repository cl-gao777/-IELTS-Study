# OpenAI-compatible provider used by the AI coach and writing evaluator.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional ordered provider list. The app tries each provider until one succeeds.
# AI_PROVIDERS_JSON=[{"name":"primary","baseUrl":"https://api.openai.com/v1","apiKey":"...","model":"...","wireApi":"responses"}]
AI_PROVIDERS_JSON=

# Local-first database.
DATABASE_URL=file:./data/ists.db
APP_TIME_ZONE=Asia/Shanghai

# Optional Notion backup. Keep these server-side only.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
