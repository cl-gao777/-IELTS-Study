{
  "name": "ielts-studio",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:morphology": "node --experimental-strip-types scripts/morphology-validate.mjs",
    "check": "npm test && npm run typecheck && npm run lint && npm run validate:morphology && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.1",
    "better-sqlite3": "^12.11.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.58.0",
    "mammoth": "^1.12.0",
    "next": "16.4.1",
    "pdf-parse": "2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "smol-toml": "^1.7.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
